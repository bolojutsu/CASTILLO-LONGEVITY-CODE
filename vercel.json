{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/contact", "destination": "/api/index" },
    { "source": "/create-checkout-session", "destination": "/api/index" },
    { "source": "/verify-session/:session_id", "destination": "/api/index" },
    { "source": "/webhook/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
